    "ajv-formats": "^3.0.1",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
